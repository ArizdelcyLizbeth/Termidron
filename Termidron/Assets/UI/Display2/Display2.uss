.display2Container {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: space-around;
	width: 100%;
	height: 100%;
}

.display2Container .textContainer {
	display: flex;
	flex-direction: column;
	width: 60%;
	height: 40%;
	justify-content: center;
	align-items: center;
	background-color: #808080;
	border-radius: 10px;
}

.display2Container .textContainer .title {
	width: 70%;
	text-align: center;
}

.display2Container .textContainer .subtitle {
	width: 70%;
	text-align: center;
}

.display2Container .buttonContainer {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 100%;
	height: 30%;
}