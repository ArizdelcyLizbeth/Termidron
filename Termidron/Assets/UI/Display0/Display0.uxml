<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement />
    <ui:VisualElement>
        <ui:VisualElement>
            <ui:Button text="Jugar" display-tooltip-when-elided="true" name="Play" />
            <ui:Button text="Créditos" display-tooltip-when-elided="true" name="Credits" />
        </ui:VisualElement>
        <ui:VisualElement>
            <ui:Button text="Salir" display-tooltip-when-elided="true" name="Exit" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
